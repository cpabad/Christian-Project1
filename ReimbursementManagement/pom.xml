<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.revature</groupId>
	<artifactId>ReimbursementManagement</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>war</packaging>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>
	<dependencies>
		<!-- https://mvnrepository.com/artifact/org.postgresql/postgresql -->
		<!-- 42.2.27 -> 42.7.11 per CVE-2024-1597 (CRITICAL, SQL injection via line comment
		     nesting in simple-query mode) and CVE-2026-42198.
		     https://avd.aquasec.com/nvd/cve-2024-1597
		     https://avd.aquasec.com/nvd/cve-2026-42198 -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.11</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.mockito/mockito-core -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>3.6.28</version>
			<scope>test</scope>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.apache.logging.log4j/log4j-core -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>2.17.1</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.zalando.stups/junit-postgres -->
		<dependency>
			<groupId>org.zalando.stups</groupId>
			<artifactId>junit-postgres</artifactId>
			<version>0.8.1</version>
			<scope>test</scope>
		</dependency>
		<!-- https://mvnrepository.com/artifact/javax.servlet/javax.servlet-api -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>3.1.0</version>
			<scope>provided</scope>
		</dependency>
		<!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-databind -->
		<!-- 2.12.7.1 -> 2.18.8 per CVE-2026-54512 / CVE-2026-54513 (databind) and
		     CVE-2025-52999 (transitive jackson-core deep-nesting StackOverflowError).
		     Jackson 2.x keeps the Java 8 baseline, so the JDK-8 pin holds.
		     https://avd.aquasec.com/nvd/cve-2026-54512
		     https://avd.aquasec.com/nvd/cve-2026-54513
		     https://avd.aquasec.com/nvd/cve-2025-52999 -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.18.8</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.hibernate/hibernate-core -->
		<!-- Stays 5.4.33.Final: CVE-2026-0603 has no fixed 5.x release and 6.x needs Java 17.
		     Accepted risk - justification and revisit condition live in .trivyignore. -->
		<dependency>
			<groupId>org.hibernate</groupId>
			<artifactId>hibernate-core</artifactId>
			<version>5.4.33.Final</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.hibernate/hibernate-ehcache -->
		<dependency>
			<groupId>org.hibernate</groupId>
			<artifactId>hibernate-ehcache</artifactId>
			<version>5.4.33.Final</version>
		</dependency>
		
		<!-- Narrowed from the full aws-java-sdk 1.11.327 bundle to the one module the code
		     uses (UploadFile.java imports only S3 + core classes, which ride in transitively).
		     The bundle dragged in vulnerable transitives: netty 4.1.17 (CVE-2019-20444
		     CRITICAL + 9 HIGH) and ion-java 1.0.2 (CVE-2024-21634); the s3 module itself
		     needed 1.12.261+ for CVE-2022-31159 (partial-path traversal in TransferManager).
		     Phase 9 (MinIO) revives this code path - keep the dep compiling until then.
		     https://avd.aquasec.com/nvd/cve-2022-31159
		     https://avd.aquasec.com/nvd/cve-2019-20444
		     https://avd.aquasec.com/nvd/cve-2024-21634 -->
		<dependency>
			<groupId>com.amazonaws</groupId>
			<artifactId>aws-java-sdk-s3</artifactId>
			<version>1.12.797</version>
		</dependency>

		<!-- BCryptPasswordEncoder for password hashing; Spring Security 5.x is Java 8 compatible (6.x needs Java 17) -->
		<!-- 5.8.5 -> 5.8.16 per CVE-2025-22228 (BCryptPasswordEncoder.matches() returns true
		     for any >72-byte password whose first 72 bytes match - BCrypt silently truncates).
		     NOTE: Trivy's listed fix (5.8.18) is a commercial-only Tanzu release; 5.8.16 is the
		     latest OSS 5.8.x on Maven Central and still carries the flag. The real mitigation
		     is the explicit 72-byte guard in UserService (see authenticate/updateProfile);
		     the residual finding is accepted in .trivyignore with this rationale.
		     https://avd.aquasec.com/nvd/cve-2025-22228 -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
			<version>5.8.16</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!-- JaCoCo: a plain `mvn test` regenerates the coverage report at target/site/jacoco/ -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.8</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<!-- Guard the advertised claim: `mvn test` fails if service-layer instruction coverage drops below 98% (denominator documented in COVERAGE.md) -->
					<execution>
						<id>check-service-coverage</id>
						<phase>test</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>PACKAGE</element>
									<includes>
										<include>com.revature.service</include>
									</includes>
									<limits>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.98</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>