<?xml version="1.0" encoding="UTF-8"?>
<!-- Test logging config: identical to the main log4j2.xml EXCEPT the FLOW logger ships OFF,
     so the request-path narration never pollutes test output. Log4j2 picks log4j2-test.* off
     the test classpath before log4j2.xml - nothing else selects this file. -->
<Configuration status="error" dest="err" name="XmlTestConfig">

	<Properties>
		<Property name="filename">logs/ExpenseReimbursementEventTrialLog.txt</Property>
	</Properties>

	<ThresholdFilter level="debug"/>

	<Appenders>
		<Console name="STDOUT" target="SYSTEM_OUT">
			<PatternLayout pattern="%m%n"/>
			<ThresholdFilter level="info"/>
		</Console>
		<File name="MyFile" fileName="${filename}">
			<PatternLayout pattern="%d{dd MMM yyyy HH:mm:ss}{GMT-6} %C{1} [%p] %m%n"/>
		</File>
		<Console name="FlowConsole" target="SYSTEM_OUT">
			<PatternLayout pattern="FLOW %m%n"/>
		</Console>
	</Appenders>

	<Loggers>
		<!-- FLOW is OFF for tests. Flip to "debug" only if you want the narration while
		     debugging a single test run. -->
		<Logger name="FLOW" level="off" additivity="false">
			<AppenderRef ref="FlowConsole"/>
		</Logger>
		<Root level="debug">
			<AppenderRef ref="STDOUT"/>
			<AppenderRef ref="MyFile"/>
		</Root>
	</Loggers>

</Configuration>
